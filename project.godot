[layer_names]

3d_physics/layer_1="default"
3d_physics/layer_2="player"
3d_physics/layer_3="environment"

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=19.619999999999997

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/16_bits=false
lights_and_shadows/positional_shadow/atlas_16_bits=false
reflections/reflection_atlas/reflection_size=128
reflections/reflection_atlas/reflection_size.mobile=64
global_illumination/gi/use_half_resolution=true
camera/depth_of_field/depth_of_field_bokeh_shape=0
environment/ssao/quality=1
environment/ssil/quality=1
occlusion_culling/occlusion_rays_per_thread=256
lightmapping/lightmap_gi/use_bicubic_filter=false
occlusion_culling/use_occlusion_culling=true
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/positional_shadow/atlas_size.mobile=1024
lights_and_shadows/positional_shadow/atlas_quadrant_0_subdiv=1
