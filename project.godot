; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project FPS"
run/main_scene="uid://dklvr5d1ntcak"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="res://icon.svg"

[autoload]

NodeIdGenerator="*uid://dixwncd3gqr47"
SaveAnimations="*uid://ckwkryqvqq6fv"
SaveDirectoryHandler="*uid://d4if61d8k85yb"
SaveManager="*uid://dlvjxklrc4tb3"
SceneManager="*uid://bre5r6xbejofr"
SceneTransitionHandler="*uid://b0s72c3fnxrp"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Project FPS"

[global_group]

save_icon=""
loading_ui=""
player=""

